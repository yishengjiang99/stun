[Unit]
Description=WebRTC P2P signaling server
After=network.target

[Service]
Type=simple
WorkingDirectory=/Users/yishengj/stun
ExecStart=/usr/bin/node /Users/yishengj/stun/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3001

# Hardening (optional)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
