[Unit]
Description=WebRTC P2P signaling server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/stun
ExecStart=/usr/bin/node /root/stun/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=SIGNALING_URL=ws://127.0.0.1:3001
Environment=FFMPEG_PATH=/usr/bin/ffmpeg

# Hardening (optional)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# ProtectHome=true blocks access to /root; disable for /root deployments
ProtectHome=false

[Install]
WantedBy=multi-user.target
